<Window
    x:Class="VniDrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:VniDrop.Platform"
    Title="VniDrop">
  <Grid x:Name="Root">
    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="Auto"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        IsBackButtonVisible="Auto"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1000"
        OpenPaneLength="248"
        AlwaysShowHeader="False"
        SelectionChanged="Navigate"
        ItemInvoked="NavigateInvoked"
        BackRequested="NavigateBack"
        IsSettingsVisible="True"
        PaneTitle="VniDrop">
      <NavigationView.MenuItems>
        <NavigationViewItem
            x:Name="NavSend"
            Content="{x:Bind p:Strings.Get('nav_send')}"
            Tag="send"
            Icon="Send" />
        <NavigationViewItem
            x:Name="NavReceive"
            Content="{x:Bind p:Strings.Get('nav_receive')}"
            Tag="receive"
            Icon="Download" />
        <NavigationViewItem
            x:Name="NavDevices"
            Content="{x:Bind p:Strings.Get('nav_saved_devices')}"
            Tag="devices">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE772;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="ErrorBar"
            Margin="24,16,24,0"
            IsOpen="{x:Bind Model.HasError, Mode=OneWay}"
            Message="{x:Bind Model.Error, Mode=OneWay}"
            Severity="Error"
            Closed="ErrorClosed" />
        <InfoBar
            Grid.Row="1"
            Margin="24,8,24,0"
            IsOpen="{x:Bind Model.HasRequests, Mode=OneWay}"
            IsClosable="False"
            Title="{x:Bind p:Strings.Get('saved_devices_attention_title')}"
            Severity="Informational">
          <InfoBar.ActionButton>
            <Button
                Content="{x:Bind p:Strings.Get('windows_review_requests')}"
                Click="ReviewRequests" />
          </InfoBar.ActionButton>
        </InfoBar>
        <Frame
            x:Name="ContentFrame"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Navigated="FrameNavigated" />
      </Grid>
    </NavigationView>

    <Border
        x:Name="Startup"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="20"
          MaxWidth="440"
          Padding="32">
        <FontIcon
            Glyph="&#xE8B7;"
            FontSize="40"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            HorizontalAlignment="Center" />
        <TextBlock
            Text="VniDrop"
            Style="{StaticResource VniDropPageTitleStyle}"
            HorizontalAlignment="Center" />
        <ProgressRing
            IsActive="{x:Bind Model.Starting, Mode=OneWay}"
            Visibility="{x:Bind Model.Starting, Mode=OneWay}"
            Width="32"
            Height="32" />
        <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button
              Content="{x:Bind p:Strings.Get('button_retry')}"
              Style="{StaticResource VniDropPrimaryButtonStyle}"
              Click="RetryStartup" />
          <Button
              Content="{x:Bind p:Strings.Get('app_identity_reset_action')}"
              Style="{StaticResource VniDropCriticalPrimaryButtonStyle}"
              Visibility="{x:Bind Model.CanResetIdentity, Mode=OneWay}"
              Click="ResetIdentity" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
