<UserControl
    x:Class="VniDrop.Views.Settings.SettingsPageLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:VniDrop.Controls">
  <Grid x:Name="Root" Padding="{StaticResource VniDropPagePaddingCompact}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="Root.Padding" Value="{StaticResource VniDropPagePaddingCompact}" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Medium">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="Root.Padding" Value="{StaticResource VniDropPagePaddingMedium}" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="Root.Padding" Value="{StaticResource VniDropPagePadding}" /></VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid x:Name="ContentColumn" HorizontalAlignment="Left" RowSpacing="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <c:PageHeader
          x:Name="Header" />
      <ScrollViewer Grid.Row="1" Style="{StaticResource VniDropPageScrollStyle}">
        <ContentPresenter x:Name="PageContentPresenter" HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
