<UserControl
    x:Class="VniDrop.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="RowSizeChanged">
  <Button
      x:Name="RootButton"
      Click="RootClicked"
      IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
    <Grid x:Name="LayoutGrid" ColumnSpacing="12" RowSpacing="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon
          x:Name="LeadingIcon"
          Grid.RowSpan="2"
          FontSize="18"
          Foreground="{Binding Foreground, ElementName=RootButton}"
          VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
        <TextBlock
            x:Name="TitleText"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="DescriptionText"
            Style="{StaticResource VniDropCaptionTextStyle}" />
      </StackPanel>
      <TextBlock
          x:Name="ValueText"
          Grid.Column="2"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis"
          MaxWidth="280"
          VerticalAlignment="Center" />
      <ContentPresenter
          x:Name="TrailingPresenter"
          Grid.Column="3"
          Grid.RowSpan="2"
          VerticalAlignment="Center" />
      <FontIcon
          x:Name="ChevronIcon"
          Grid.Column="4"
          Grid.RowSpan="2"
          Glyph="&#xE76C;"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
