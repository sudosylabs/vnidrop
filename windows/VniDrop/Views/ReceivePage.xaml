<ContentDialog
    x:Class="VniDrop.Views.ReceivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VniDrop.Controls"
    xmlns:p="using:VniDrop.Platform"
    CloseButtonText="{x:Bind p:Strings.Get('button_cancel')}"
    PrimaryButtonClick="Receive"
    Closing="OnClosing"
    DefaultButton="None"
    HorizontalContentAlignment="Stretch"
    CornerRadius="{StaticResource VniDropCardCornerRadius}"
    PrimaryButtonStyle="{StaticResource VniDropDialogAccentButtonStyle}"
    CloseButtonStyle="{StaticResource VniDropDialogButtonStyle}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
  </ContentDialog.Resources>
  <ContentDialog.Title>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
          x:Name="BackButton"
          Style="{StaticResource VniDropIconButtonStyle}"
          Visibility="Collapsed"
          Click="Back"
          AutomationProperties.Name="{x:Bind p:Strings.Get('button_back')}"
          ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_back')}">
        <FontIcon Glyph="&#xE72B;" FontSize="16" />
      </Button>
      <TextBlock
          x:Name="Heading"
          Grid.Column="1"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
    </Grid>
  </ContentDialog.Title>
  <ScrollViewer
      Style="{StaticResource VniDropPageScrollStyle}"
      MaxHeight="640">
    <StackPanel Spacing="16">
      <InfoBar x:Name="Error" Severity="Error" IsOpen="False" />

      <StackPanel x:Name="Acquisition" Spacing="16">
        <TextBlock
            Text="{x:Bind p:Strings.Get('receive_choose_method_body')}"
            Style="{StaticResource VniDropSecondaryTextStyle}" />
        <Border Style="{StaticResource VniDropCardStyle}">
          <controls:SettingsRow
              x:Name="OpenInvitationButton"
              AutomationProperties.AutomationId="OpenInvitationButton"
              Glyph="&#xE8A5;"
              Title="{x:Bind p:Strings.Get('receive_method_file')}"
              Description="{x:Bind p:Strings.Get('receive_method_file_description')}"
              ShowChevron="True"
              Click="OpenInvitation" />
        </Border>
      </StackPanel>

      <ProgressRing
          x:Name="Busy"
          AutomationProperties.Name="{x:Bind p:Strings.Get('progress_working')}"
          AutomationProperties.LiveSetting="Polite"
          IsActive="False"
          IsTabStop="False"
          Visibility="Collapsed"
          Width="28"
          Height="28"
          HorizontalAlignment="Center" />

      <StackPanel x:Name="Review" Spacing="18" Visibility="Collapsed">
        <Border Style="{StaticResource VniDropCardStyle}" Padding="16">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Glyph="&#xE8A5;"
                FontSize="22"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock
                  x:Name="TransferTitle"
                  Style="{StaticResource BodyStrongTextBlockStyle}"
                  TextWrapping="Wrap" />
              <TextBlock x:Name="Summary" Style="{StaticResource VniDropCaptionTextStyle}" />
              <TextBlock x:Name="Sender" Style="{StaticResource VniDropCaptionTextStyle}" />
            </StackPanel>
          </Grid>
        </Border>
        <TextBox
            x:Name="ReceiverName"
            Header="{x:Bind p:Strings.Get('field_receiver_name')}"
            MaxLength="100" />
        <Border Style="{StaticResource VniDropCardStyle}">
          <Grid Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8B7;" FontSize="18" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock
                  Text="{x:Bind p:Strings.Get('preferences_receive_folder_title')}"
                  Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock x:Name="Destination" Style="{StaticResource VniDropCaptionTextStyle}" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel x:Name="Receiving" Spacing="10" Visibility="Collapsed">
          <ProgressBar
              x:Name="ReceiveProgress"
              AutomationProperties.AutomationId="ReceiveProgress"
              AutomationProperties.Name="{x:Bind p:Strings.Get('progress_connecting')}"
              IsIndeterminate="True"
              IsTabStop="True" />
          <TextBlock
              x:Name="ProgressLabel"
              AutomationProperties.AutomationId="ReceiveProgressStatus"
              AutomationProperties.LiveSetting="Polite"
              Style="{StaticResource VniDropSecondaryTextStyle}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
