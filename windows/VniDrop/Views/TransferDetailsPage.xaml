<Page
    x:Class="VniDrop.Views.TransferDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VniDrop.Controls"
    xmlns:p="using:VniDrop.Platform">
  <Grid
      x:Name="PageRoot"
      Padding="{StaticResource VniDropPagePadding}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageRoot.Padding" Value="{StaticResource VniDropPagePaddingCompact}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Medium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageRoot.Padding" Value="{StaticResource VniDropPagePaddingMedium}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1000" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageRoot.Padding" Value="{StaticResource VniDropPagePadding}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer Style="{StaticResource VniDropPageScrollStyle}">
      <StackPanel
          Spacing="20"
          MaxWidth="{StaticResource VniDropReadingMaxWidth}"
          HorizontalAlignment="Left">
        <controls:PageHeader Title="{x:Bind p:Strings.Get('send_transfer_details_title')}">
          <controls:PageHeader.Actions>
            <Button
                x:Name="ShareButton"
                AutomationProperties.AutomationId="ShareTransferButton"
                Visibility="Collapsed"
                Style="{StaticResource VniDropIconButtonStyle}"
                Click="Share"
                AutomationProperties.Name="{x:Bind p:Strings.Get('transfer_share_title')}"
                ToolTipService.ToolTip="{x:Bind p:Strings.Get('transfer_share_title')}">
              <FontIcon Glyph="&#xE72D;" FontSize="16" />
            </Button>
          </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Style="{StaticResource VniDropCardStyle}" Padding="18">
          <StackPanel Spacing="14">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                  Width="44"
                  Height="44"
                  CornerRadius="8"
                  Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <FontIcon
                    Glyph="&#xE8A5;"
                    FontSize="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Border>
              <TextBlock
                  Grid.Column="1"
                  Text="{x:Bind Item.Name, Mode=OneWay}"
                  Style="{StaticResource SubtitleTextBlockStyle}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
              <controls:StatusBadge
                  Grid.Column="2"
                  Text="{x:Bind Item.Status, Mode=OneWay}"
                  Glyph="{x:Bind Item.StatusGlyph, Mode=OneWay}"
                  Tone="{x:Bind Item.StatusTone, Mode=OneWay}"
                  VerticalAlignment="Center" />
            </Grid>
            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind p:Strings.Get('metadata_size')}"
                    Style="{StaticResource VniDropCaptionTextStyle}" />
                <TextBlock Text="{x:Bind Item.Summary, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="AccessRow" Grid.Column="1" Spacing="4" Visibility="Collapsed">
                <TextBlock
                    Text="{x:Bind p:Strings.Get('send_access_title')}"
                    Style="{StaticResource VniDropCaptionTextStyle}" />
                <TextBlock Text="{x:Bind Item.Access, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Rectangle x:Name="AccessDivider" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="Collapsed" />
            <StackPanel Visibility="{x:Bind Item.ShowProgress, Mode=OneWay}" Spacing="6">
              <ProgressBar
                  Value="{x:Bind Item.Progress, Mode=OneWay}"
                  IsIndeterminate="{x:Bind Item.IsIndeterminate, Mode=OneWay}" />
              <TextBlock
                  Text="{x:Bind Item.ProgressText, Mode=OneWay}"
                  Style="{StaticResource VniDropSecondaryTextStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border x:Name="Destinations" Style="{StaticResource VniDropCardStyle}" Visibility="Collapsed">
          <StackPanel>
            <controls:SettingsRow
                x:Name="ActivityButton"
                AutomationProperties.AutomationId="TransferActivityButton"
                Glyph="&#xE823;"
                Title="{x:Bind p:Strings.Get('transfer_activity_title')}"
                Description="{x:Bind p:Strings.Get('transfer_activity_description')}"
                ShowChevron="True"
                Click="Activity" />
            <Rectangle Height="1" Margin="52,0,0,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            <controls:SettingsRow
                x:Name="ReceiversButton"
                AutomationProperties.AutomationId="TransferReceiversButton"
                Glyph="&#xE716;"
                Title="{x:Bind p:Strings.Get('transfer_receivers_title')}"
                ShowChevron="True"
                Click="Receivers" />
          </StackPanel>
        </Border>

        <StackPanel x:Name="FilesSection" Spacing="10" Visibility="Collapsed">
          <TextBlock
              Text="{x:Bind p:Strings.Get('metadata_files')}"
              Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}" Padding="8">
            <ItemsControl x:Name="Files" />
          </Border>
        </StackPanel>

        <StackPanel x:Name="ActionsSection" Spacing="8" Visibility="Collapsed">
          <TextBlock
              Text="{x:Bind p:Strings.Get('button_more_actions')}"
              Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}">
            <StackPanel>
              <controls:SettingsRow
                  x:Name="StopButton"
                  AutomationProperties.AutomationId="StopTransferButton"
                  Glyph="&#xE71A;"
                  Visibility="Collapsed"
                  IsCritical="True"
                  Click="Stop" />
              <Rectangle x:Name="ActionsDivider" Height="1" Margin="52,0,0,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="Collapsed" />
              <controls:SettingsRow
                  x:Name="DeleteButton"
                  AutomationProperties.AutomationId="DeleteTransferButton"
                  Glyph="&#xE74D;"
                  Visibility="Collapsed"
                  Title="{x:Bind p:Strings.Get('button_delete_transfer')}"
                  IsCritical="True"
                  Click="Delete" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
