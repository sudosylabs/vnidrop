<UserControl
    x:Class="VniDrop.Controls.DeviceDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VniDrop.Controls"
    xmlns:p="using:VniDrop.Platform"
    xmlns:vm="using:VniDrop.ViewModels">
  <StackPanel x:Name="Root" Spacing="20" Visibility="Collapsed">
    <Border Style="{StaticResource VniDropCardStyle}" Padding="18">
      <StackPanel Spacing="14">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
              Width="52"
              Height="52"
              CornerRadius="10"
              Background="{ThemeResource ControlFillColorSecondaryBrush}">
            <FontIcon
                Glyph="&#xE772;"
                FontSize="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock
                x:Name="DeviceNameText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="AuthenticatedNameText"
                Style="{StaticResource VniDropCaptionTextStyle}"
                TextWrapping="Wrap" />
          </StackPanel>
          <ProgressRing
              x:Name="DeviceBusyIndicator"
              Grid.Column="2"
              Width="20"
              Height="20"
              IsActive="False"
              Visibility="Collapsed"
              VerticalAlignment="Center" />
        </Grid>
        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
        <TextBlock
            x:Name="EndpointText"
            Style="{StaticResource VniDropSecondaryTextStyle}"
            TextWrapping="WrapWholeWords" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource VniDropCardStyle}">
      <StackPanel>
        <controls:SettingsRow
            x:Name="SendAction"
            Glyph="&#xE724;"
            Title="{x:Bind p:Strings.Get('saved_devices_send_action')}"
            ShowChevron="True"
            Click="SendFiles" />
        <Rectangle Height="1" Margin="52,0,0,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
        <controls:SettingsRow
            x:Name="LabelAction"
            Glyph="&#xE70F;"
            Title="{x:Bind p:Strings.Get('saved_devices_label_action')}"
            ShowChevron="True"
            Click="EditLabel" />
      </StackPanel>
    </Border>

    <StackPanel Spacing="10">
      <TextBlock
          Text="{x:Bind p:Strings.Get('saved_devices_transfers_title')}"
          Style="{StaticResource VniDropSectionTitleStyle}" />
      <TextBlock
          x:Name="NoTransfersText"
          Text="{x:Bind p:Strings.Get('saved_devices_transfer_empty')}"
          Style="{StaticResource VniDropSecondaryTextStyle}"
          Margin="2,4" />
      <ItemsControl x:Name="Transfers">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DeviceTransferItem">
            <Border
                Style="{StaticResource VniDropCardStyle}"
                Padding="14"
                Margin="0,0,0,8"
                Tag="{x:Bind}"
                Loaded="TransferRowLoaded"
                AutomationProperties.Name="{x:Bind AutomationName}">
              <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      Text="{x:Bind Title}"
                      Style="{StaticResource BodyStrongTextBlockStyle}"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center" />
                  <controls:StatusBadge
                      Grid.Column="1"
                      Text="{x:Bind Status}"
                      Glyph="{x:Bind StatusGlyph}"
                      Tone="{x:Bind StatusTone}"
                      VerticalAlignment="Center" />
                </Grid>
                <TextBlock
                    Text="{x:Bind Summary}"
                    Style="{StaticResource VniDropCaptionTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel Visibility="{x:Bind ProgressVisibility}" Spacing="5">
                  <ProgressBar Value="{x:Bind Progress}" />
                  <TextBlock
                      Text="{x:Bind ProgressText}"
                      Style="{StaticResource VniDropCaptionTextStyle}" />
                </StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Style="{StaticResource VniDropPrimaryButtonStyle}"
                         Content="{x:Bind PrimaryText}"
                         Visibility="{x:Bind PrimaryVisibility}"
                         IsEnabled="{x:Bind IsPrimaryEnabled}"
                        Tag="{x:Bind}"
                        Click="TransferPrimary" />
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind IsBusy}"
                        Visibility="{x:Bind BusyVisibility}"
                        VerticalAlignment="Center" />
                  </StackPanel>
                  <Button
                       HorizontalAlignment="Right"
                       Style="{StaticResource VniDropIconButtonStyle}"
                       IsEnabled="{x:Bind IsMoreEnabled}"
                      Tag="{x:Bind}"
                      Click="TransferMore"
                      AutomationProperties.Name="{x:Bind p:Strings.Get('button_more_actions')}"
                      ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_more_actions')}">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock
          x:Name="MoreActionsTitle"
          Style="{StaticResource VniDropSectionTitleStyle}" />
      <Border Style="{StaticResource VniDropCardStyle}">
        <StackPanel>
          <controls:SettingsRow
              x:Name="ForgetAction"
              Glyph="&#xE74D;"
              Title="{x:Bind p:Strings.Get('saved_devices_forget_action')}"
              IsCritical="True"
              Click="Forget" />
          <Rectangle Height="1" Margin="52,0,0,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
          <controls:SettingsRow
              x:Name="BlockAction"
              Glyph="&#xE733;"
              Title="{x:Bind p:Strings.Get('saved_devices_block_action')}"
              IsCritical="True"
              Click="Block" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
