<Page
    x:Class="VniDrop.Views.Settings.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:VniDrop.Platform"
    xmlns:settings="using:VniDrop.Views.Settings">
  <settings:SettingsPageLayout Title="{x:Bind p:Strings.Get('settings_network_title')}" BackRequested="Back">
    <settings:SettingsPageLayout.PageContent>
      <StackPanel Spacing="20">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind p:Strings.Get('settings_network_title')}" Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}" Padding="16,12">
            <RadioButtons
                x:Name="ModeChoices"
                MaxColumns="1"
                AutomationProperties.Name="{x:Bind p:Strings.Get('settings_network_title')}"
                SelectionChanged="ModeChanged">
              <RadioButton
                  x:Name="Automatic"
                  Content="{x:Bind p:Strings.Get('relay_mode_automatic')}"
                  AutomationProperties.HelpText="{x:Bind p:Strings.Get('relay_mode_automatic_description')}" />
              <RadioButton
                  x:Name="StrictCustom"
                  Content="{x:Bind p:Strings.Get('relay_mode_custom')}"
                  AutomationProperties.HelpText="{x:Bind p:Strings.Get('relay_mode_custom_description')}" />
              <RadioButton
                  x:Name="CustomWithDirectFallback"
                  Content="{x:Bind p:Strings.Get('relay_mode_custom_direct_fallback')}"
                  AutomationProperties.HelpText="{x:Bind p:Strings.Get('relay_mode_custom_direct_fallback_description')}" />
              <RadioButton
                  x:Name="LocalOnly"
                  Content="{x:Bind p:Strings.Get('relay_mode_local_only')}"
                  AutomationProperties.HelpText="{x:Bind p:Strings.Get('relay_mode_local_only_description')}" />
            </RadioButtons>
          </Border>
          <TextBlock
              x:Name="ModeDescription"
              Style="{StaticResource VniDropSecondaryTextStyle}"
              AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Message="{x:Bind p:Strings.Get('relay_privacy_description')}" />

        <Border Style="{StaticResource VniDropCardStyle}" Padding="16">
          <TextBlock
              x:Name="DeviceId"
              FontFamily="Consolas"
              TextWrapping="Wrap" />
        </Border>

        <StackPanel x:Name="RelayUrls" Spacing="10">
          <TextBlock Text="{x:Bind p:Strings.Get('relay_custom_urls_label')}" Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}" Padding="16">
            <StackPanel Spacing="10">
              <ItemsControl x:Name="UrlList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:RelayUrlEntry">
                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox
                          Text="{x:Bind Url}"
                          Tag="{x:Bind}"
                          TextChanged="UrlChanged"
                          HorizontalAlignment="Stretch" />
                      <Button
                          Grid.Column="1"
                          Style="{StaticResource VniDropIconButtonStyle}"
                          Tag="{x:Bind}"
                          Click="RemoveUrl"
                          AutomationProperties.Name="{x:Bind p:Strings.Get('relay_remove_url')}"
                          ToolTipService.ToolTip="{x:Bind p:Strings.Get('relay_remove_url')}">
                        <FontIcon Glyph="&#xE738;" FontSize="16" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button
                  x:Name="AddRelay"
                  Style="{StaticResource VniDropSecondaryButtonStyle}"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="{x:Bind p:Strings.Get('relay_add_url')}"
                  Click="AddUrl">
                <StackPanel Style="{StaticResource VniDropButtonContentPanelStyle}">
                  <FontIcon Glyph="&#xE710;" Style="{StaticResource VniDropButtonContentIconStyle}" />
                  <TextBlock Text="{x:Bind p:Strings.Get('relay_add_url')}" Style="{StaticResource VniDropButtonContentTextStyle}" />
                </StackPanel>
              </Button>
              <TextBlock Text="{x:Bind p:Strings.Get('relay_custom_urls_help')}" Style="{StaticResource VniDropCaptionTextStyle}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <InfoBar x:Name="StrictWarning" Severity="Warning" IsOpen="False" IsClosable="False" Message="{x:Bind p:Strings.Get('relay_strict_warning')}" />
        <TextBlock Text="{x:Bind p:Strings.Get('relay_apply_restart_description')}" Style="{StaticResource VniDropSecondaryTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ApplyNetwork" Style="{StaticResource VniDropPrimaryButtonStyle}" Content="{x:Bind p:Strings.Get('relay_apply')}" Click="SaveNetwork" />
          <ProgressRing x:Name="Applying" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
        </StackPanel>
      </StackPanel>
    </settings:SettingsPageLayout.PageContent>
  </settings:SettingsPageLayout>
</Page>
