<ContentDialog x:Class="VniDrop.Views.ReceivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:VniDrop.Platform"
    CloseButtonText="{x:Bind p:Strings.Get('button_cancel')}" PrimaryButtonClick="Receive" Closing="OnClosing" DefaultButton="Primary"
    HorizontalContentAlignment="Stretch" CornerRadius="12" PrimaryButtonStyle="{StaticResource DialogAccentButtonStyle}" CloseButtonStyle="{StaticResource DialogButtonStyle}">
  <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">600</x:Double></ContentDialog.Resources>
  <ContentDialog.Title>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Visibility="Collapsed" Click="Back"
          AutomationProperties.Name="{x:Bind p:Strings.Get('button_back')}" ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_back')}"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
      <TextBlock x:Name="Heading" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
    </Grid>
  </ContentDialog.Title>
  <ScrollViewer Style="{StaticResource PageScroll}" MinWidth="300">
    <StackPanel Spacing="16">
      <InfoBar x:Name="Error" Severity="Error" IsOpen="False" />
      <StackPanel x:Name="Acquisition" Spacing="16">
        <TextBlock Text="{x:Bind p:Strings.Get('receive_choose_method_body')}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="OpenInvitationButton" Click="OpenInvitation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
            <SymbolIcon Symbol="Document" />
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind p:Strings.Get('receive_method_file')}" /><TextBlock Text="{x:Bind p:Strings.Get('receive_method_file_description')}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
          </Grid>
        </Button>
      </StackPanel>
      <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" Width="28" Height="28" />
      <StackPanel x:Name="Review" Spacing="18" Visibility="Collapsed">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
          <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <SymbolIcon Symbol="Document" />
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock x:Name="TransferTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /><TextBlock x:Name="Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="Sender" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
          </Grid>
        </Border>
        <TextBox x:Name="ReceiverName" Header="{x:Bind p:Strings.Get('field_receiver_name')}" MaxLength="100" />
        <StackPanel Spacing="6"><TextBlock Text="{x:Bind p:Strings.Get('preferences_receive_folder_title')}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="Destination" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
        <StackPanel x:Name="Receiving" Spacing="10" Visibility="Collapsed"><ProgressBar x:Name="ReceiveProgress" IsIndeterminate="True" /><TextBlock x:Name="ProgressLabel" TextWrapping="Wrap" /></StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
