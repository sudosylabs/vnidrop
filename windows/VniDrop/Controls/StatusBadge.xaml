<UserControl
    x:Class="VniDrop.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ToneStates">
        <VisualState x:Name="Neutral">
          <VisualState.Setters>
            <Setter Target="BadgeBorder.BorderBrush" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Target="BadgeIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Target="BadgeText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Accent">
          <VisualState.Setters>
            <Setter Target="BadgeBorder.BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Target="BadgeIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Target="BadgeText.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Success">
          <VisualState.Setters>
            <Setter Target="BadgeBorder.BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Target="BadgeIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Target="BadgeText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Warning">
          <VisualState.Setters>
            <Setter Target="BadgeBorder.BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Target="BadgeIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Target="BadgeText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Critical">
          <VisualState.Setters>
            <Setter Target="BadgeBorder.BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Target="BadgeIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Target="BadgeText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border
        x:Name="BadgeBorder"
        Background="{ThemeResource ControlFillColorSecondaryBrush}"
        CornerRadius="{StaticResource VniDropBadgeCornerRadius}"
        BorderThickness="1"
        Padding="8,3">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon x:Name="BadgeIcon" FontSize="10" />
        <TextBlock x:Name="BadgeText" Style="{StaticResource CaptionTextBlockStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
