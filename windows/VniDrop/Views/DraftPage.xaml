<ContentDialog x:Class="VniDrop.Views.DraftPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:VniDrop.Platform" xmlns:vm="using:VniDrop.ViewModels"
    CloseButtonText="{x:Bind p:Strings.Get('button_cancel')}" PrimaryButtonClick="Submit" Closing="OnClosing"
    DefaultButton="Primary" HorizontalContentAlignment="Stretch" CornerRadius="12"
    PrimaryButtonStyle="{StaticResource DialogAccentButtonStyle}" CloseButtonStyle="{StaticResource DialogButtonStyle}">
  <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">620</x:Double></ContentDialog.Resources>
  <ContentDialog.Title>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="ChooseAgain" Visibility="Collapsed"
          AutomationProperties.Name="{x:Bind p:Strings.Get('button_back')}" ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_back')}"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
      <TextBlock x:Name="Heading" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
    </Grid>
  </ContentDialog.Title>
  <ScrollViewer Style="{StaticResource PageScroll}" MinWidth="300">
    <StackPanel Spacing="16">
      <InfoBar x:Name="Error" Severity="Error" IsOpen="False" />
      <StackPanel x:Name="ChooseStep" Spacing="20">
        <TextBlock Text="{x:Bind p:Strings.Get('send_choose_file_body')}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="28" AllowDrop="True" DragOver="DragOverFiles" Drop="DropFiles">
          <StackPanel Spacing="16" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ChooseFilesButton" Style="{StaticResource AccentButtonStyle}" Click="ChooseFiles" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Document" /><TextBlock Text="{x:Bind p:Strings.Get('button_choose_files')}" /></StackPanel></Button>
            <Button x:Name="ChooseFolderButton" Click="ChooseFolder" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Folder" /><TextBlock Text="{x:Bind p:Strings.Get('button_choose_folder')}" /></StackPanel></Button>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="ReviewStep" Spacing="16" Visibility="Collapsed">
        <TextBlock x:Name="Recipient" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="SelectionSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ListView x:Name="Sources" SelectionMode="None" MaxHeight="180" HorizontalContentAlignment="Stretch">
          <ListView.ItemTemplate><DataTemplate x:DataType="vm:DraftSourceItem">
            <Border Padding="14" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" Background="{ThemeResource ControlFillColorSecondaryBrush}"><FontIcon Glyph="{x:Bind Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="{x:Bind Source}" Click="RemoveSource" AutomationProperties.Name="{x:Bind p:Strings.Get('button_remove_file')}" ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_remove_file')}"><FontIcon Glyph="&#xE74D;" FontSize="16" /></Button>
              </Grid>
            </Border>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBox x:Name="TransferName" Header="{x:Bind p:Strings.Get('field_transfer_name')}" TextChanged="NameChanged" MaxLength="240" />
        <TextBox x:Name="SenderName" Header="{x:Bind p:Strings.Get('field_sender_name')}" MaxLength="100" />
        <StackPanel x:Name="AccessOptions" Spacing="8">
          <TextBlock Text="{x:Bind p:Strings.Get('send_access_title')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <RadioButton x:Name="Approval" Style="{StaticResource PolicyOptionStyle}" GroupName="Access" IsChecked="True" Checked="AccessChanged">
            <StackPanel Spacing="3"><TextBlock Text="{x:Bind p:Strings.Get('send_access_approval')}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind p:Strings.Get('send_access_approval_description')}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="Anyone" Style="{StaticResource PolicyOptionStyle}" GroupName="Access" Checked="AccessChanged">
            <StackPanel Spacing="3"><TextBlock Text="{x:Bind p:Strings.Get('send_access_anyone')}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind p:Strings.Get('send_access_anyone_description')}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
          </RadioButton>
          <InfoBar x:Name="PublicWarning" IsOpen="False" Severity="Warning" IsClosable="False" Message="{x:Bind p:Strings.Get('send_access_anyone_warning')}" />
        </StackPanel>
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
          <AppBarButton Icon="Document" Label="{x:Bind p:Strings.Get('button_change_files')}" Click="ChooseFiles" />
          <AppBarButton Icon="Folder" Label="{x:Bind p:Strings.Get('button_choose_folder')}" Click="ChooseFolder" />
          <AppBarButton Icon="Clear" Label="{x:Bind p:Strings.Get('button_clear')}" Click="ClearSelection" />
        </CommandBar>
      </StackPanel>
      <StackPanel x:Name="Preparation" Visibility="Collapsed" Spacing="8"><ProgressBar IsIndeterminate="True" /><TextBlock Text="{x:Bind p:Strings.Get('button_sharing_file')}" /></StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
