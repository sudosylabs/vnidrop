<Page
    x:Class="VniDrop.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VniDrop.Controls"
    xmlns:p="using:VniDrop.Platform"
    xmlns:vm="using:VniDrop.ViewModels">
  <Page.Resources>
    <DataTemplate x:Key="DeviceActionRowTemplate" x:DataType="vm:DeviceActionRowItem">
      <Border
          Style="{StaticResource VniDropCardStyle}"
          Padding="14"
          Margin="0,0,0,8"
          AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid ColumnSpacing="12" RowSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border
              Width="42"
              Height="42"
              CornerRadius="8"
              Background="{ThemeResource ControlFillColorSecondaryBrush}">
            <FontIcon
                Glyph="{x:Bind Glyph}"
                FontSize="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock
                Text="{x:Bind Name}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Text="{x:Bind Detail}"
                Style="{StaticResource VniDropCaptionTextStyle}"
                TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel
              Grid.Row="1"
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="8">
            <Button
                Style="{StaticResource VniDropPrimaryButtonStyle}"
                Content="{x:Bind PrimaryText}"
                Visibility="{x:Bind PrimaryVisibility}"
                IsEnabled="{x:Bind IsEnabled}"
                Tag="{x:Bind}"
                Click="ActionPrimary" />
            <Button
                Style="{StaticResource VniDropSecondaryButtonStyle}"
                Content="{x:Bind SecondaryText}"
                Visibility="{x:Bind SecondaryVisibility}"
                IsEnabled="{x:Bind IsEnabled}"
                Tag="{x:Bind}"
                Click="ActionSecondary" />
            <ProgressRing
                Width="18"
                Height="18"
                IsActive="{x:Bind IsBusy}"
                Visibility="{x:Bind BusyVisibility}"
                VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TargetedTransferRowTemplate" x:DataType="vm:DeviceTransferItem">
      <Border
          Style="{StaticResource VniDropCardStyle}"
          Padding="14"
          Margin="0,0,0,8"
          Tag="{x:Bind}"
          Loaded="GlobalTransferRowLoaded"
          AutomationProperties.Name="{x:Bind AutomationName}">
        <StackPanel Spacing="10">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{x:Bind Title}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
            <controls:StatusBadge
                Grid.Column="1"
                Text="{x:Bind Status}"
                Glyph="{x:Bind StatusGlyph}"
                Tone="{x:Bind StatusTone}"
                VerticalAlignment="Center" />
          </Grid>
          <TextBlock
              Text="{x:Bind Summary}"
              Style="{StaticResource VniDropCaptionTextStyle}"
              TextWrapping="Wrap" />
          <StackPanel Visibility="{x:Bind ProgressVisibility}" Spacing="5">
            <ProgressBar Value="{x:Bind Progress}" />
            <TextBlock
                Text="{x:Bind ProgressText}"
                Style="{StaticResource VniDropCaptionTextStyle}" />
          </StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button
                  Style="{StaticResource VniDropPrimaryButtonStyle}"
                  Content="{x:Bind PrimaryText}"
                  Visibility="{x:Bind PrimaryVisibility}"
                  IsEnabled="{x:Bind IsPrimaryEnabled}"
                  Tag="{x:Bind}"
                  Click="GlobalTransferPrimary" />
              <ProgressRing
                  Width="18"
                  Height="18"
                  IsActive="{x:Bind IsBusy}"
                  Visibility="{x:Bind BusyVisibility}"
                  VerticalAlignment="Center" />
            </StackPanel>
            <Button
                HorizontalAlignment="Right"
                Style="{StaticResource VniDropIconButtonStyle}"
                IsEnabled="{x:Bind IsMoreEnabled}"
                Tag="{x:Bind}"
                Click="GlobalTransferMore"
                AutomationProperties.Name="{x:Bind p:Strings.Get('button_more_actions')}"
                ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_more_actions')}">
              <FontIcon Glyph="&#xE712;" FontSize="16" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid
      x:Name="PageRoot"
      Padding="{StaticResource VniDropPagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Title="{x:Bind p:Strings.Get('nav_saved_devices')}" />

    <Grid
        x:Name="BodyHost"
        Grid.Row="1"
        Margin="0,16,0,0">
      <Grid
          x:Name="BodyGrid"
          MaxWidth="{StaticResource VniDropPageMaxWidth}"
          HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="PaneDividerColumn" Width="0" />
          <ColumnDefinition x:Name="DetailsColumn" Width="0" />
        </Grid.ColumnDefinitions>

      <ScrollViewer Style="{StaticResource VniDropPageScrollStyle}">
        <StackPanel x:Name="ListContent" Spacing="20">
          <StackPanel x:Name="PendingSection" Spacing="10" Visibility="Collapsed">
            <TextBlock
                Text="{x:Bind p:Strings.Get('saved_devices_pending_title')}"
                Style="{StaticResource VniDropSectionTitleStyle}" />
            <ItemsControl
                x:Name="PendingItems"
                ItemTemplate="{StaticResource DeviceActionRowTemplate}" />
          </StackPanel>

          <StackPanel x:Name="EligibleSection" Spacing="10" Visibility="Collapsed">
            <TextBlock
                Text="{x:Bind p:Strings.Get('saved_devices_eligibility_title')}"
                Style="{StaticResource VniDropSectionTitleStyle}" />
            <ItemsControl
                x:Name="EligibleItems"
                ItemTemplate="{StaticResource DeviceActionRowTemplate}" />
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock
                Text="{x:Bind p:Strings.Get('saved_devices_list_title')}"
                Style="{StaticResource VniDropSectionTitleStyle}" />
            <controls:EmptyState
                x:Name="SavedEmpty"
                Glyph="&#xE772;"
                Title="{x:Bind p:Strings.Get('saved_devices_empty_title')}"
                Description="{x:Bind p:Strings.Get('saved_devices_empty')}"
                Visibility="Collapsed" />
            <ListView
                x:Name="SavedDevices"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="DeviceClicked"
                SelectionChanged="DeviceSelectionChanged"
                ItemContainerStyle="{StaticResource VniDropTransferListItemStyle}"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SavedDeviceItem">
                  <Grid
                      Padding="14"
                      ColumnSpacing="12"
                      Tag="{x:Bind}"
                      Loaded="DeviceRowLoaded"
                      AutomationProperties.Name="{x:Bind AutomationName}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                      <FontIcon
                          Glyph="&#xE772;"
                          FontSize="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock
                          Text="{x:Bind Name}"
                          Style="{StaticResource BodyStrongTextBlockStyle}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Text="{x:Bind Detail}"
                          Style="{StaticResource VniDropCaptionTextStyle}"
                          TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                      <controls:StatusBadge
                          Text="{x:Bind TransferCount}"
                          Tone="Accent"
                          Visibility="{x:Bind CountVisibility}" />
                      <ProgressRing
                          Width="18"
                          Height="18"
                          IsActive="{x:Bind IsBusy}"
                          Visibility="{x:Bind BusyVisibility}" />
                    </Grid>
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource VniDropIconButtonStyle}"
                        IsEnabled="{x:Bind IsEnabled}"
                        Tag="{x:Bind}"
                        Click="DeviceMore"
                        AutomationProperties.Name="{x:Bind p:Strings.Get('button_more_actions')}"
                        ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_more_actions')}">
                      <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>

          <StackPanel x:Name="TransfersSection" Spacing="10" Visibility="Collapsed">
            <TextBlock
                Text="{x:Bind p:Strings.Get('saved_devices_transfers_title')}"
                Style="{StaticResource VniDropSectionTitleStyle}" />
            <ItemsControl
                x:Name="GlobalTransfers"
                ItemTemplate="{StaticResource TargetedTransferRowTemplate}" />
          </StackPanel>

          <StackPanel x:Name="BlockedSection" Spacing="10" Visibility="Collapsed">
            <TextBlock
                Text="{x:Bind p:Strings.Get('windows_blocked_devices')}"
                Style="{StaticResource VniDropSectionTitleStyle}" />
            <ItemsControl
                x:Name="BlockedItems"
                ItemTemplate="{StaticResource DeviceActionRowTemplate}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

        <Rectangle
            x:Name="PaneDivider"
            Grid.Column="1"
            Width="1"
            Margin="18,0"
            Fill="{ThemeResource CardStrokeColorDefaultBrush}"
            Visibility="Collapsed" />

        <ScrollViewer
            x:Name="DetailsHost"
            Grid.Column="2"
            Style="{StaticResource VniDropPageScrollStyle}"
            Visibility="Collapsed">
          <controls:DeviceDetailsView x:Name="DetailsView" Margin="20,0,0,0" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Page>
