<Page
    x:Class="VniDrop.Views.Settings.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:VniDrop.Platform"
    xmlns:settings="using:VniDrop.Views.Settings">
  <settings:SettingsPageLayout Title="{x:Bind p:Strings.Get('preferences_title')}" BackRequested="Back">
    <settings:SettingsPageLayout.PageContent>
      <StackPanel Spacing="24">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind p:Strings.Get('field_username')}" Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}" Padding="16">
            <TextBox
                x:Name="Username"
                AutomationProperties.AutomationId="DisplayNameTextBox"
                Header="{x:Bind p:Strings.Get('field_username')}"
                MaxLength="100"
                TextChanged="UsernameChanged"
                LostFocus="UsernameLostFocus" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind p:Strings.Get('preferences_receive_folder_title')}" Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}" Padding="16">
            <StackPanel Spacing="14">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <SymbolIcon Symbol="Folder" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock x:Name="ReceiveFolder" Grid.Column="1" TextWrapping="Wrap" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="ChooseReceiveFolderButton" Style="{StaticResource VniDropSecondaryButtonStyle}" Click="ChooseFolder">
                  <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Folder" /><TextBlock Text="{x:Bind p:Strings.Get('button_choose_folder')}" /></StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="ResetReceiveFolderButton" Style="{StaticResource VniDropSecondaryButtonStyle}" Content="{x:Bind p:Strings.Get('button_reset_default')}" Click="ResetFolder" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <ProgressRing
            x:Name="Saving"
            Width="24"
            Height="24"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind p:Strings.Get('progress_saving')}"
            IsActive="False"
            IsTabStop="False"
            Visibility="Collapsed" />
      </StackPanel>
    </settings:SettingsPageLayout.PageContent>
  </settings:SettingsPageLayout>
</Page>
