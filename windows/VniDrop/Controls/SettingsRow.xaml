<UserControl
    x:Class="VniDrop.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="RowSizeChanged">
  <Button
      x:Name="RootButton"
      Click="RootClicked"
      IsEnabled="{x:Bind IsEnabled, Mode=OneWay}">
    <Grid x:Name="LayoutGrid" ColumnSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon
          x:Name="LeadingIcon"
          Style="{StaticResource VniDropRowContentIconStyle}"
          Foreground="{Binding Foreground, ElementName=RootButton}"
          VerticalAlignment="Center" />
      <TextBlock
          x:Name="TitleText"
          Grid.Column="1"
          Style="{StaticResource VniDropRowContentTitleStyle}" />
      <TextBlock
          x:Name="DescriptionText"
          Grid.Row="1"
          Grid.Column="1"
          Style="{StaticResource VniDropRowContentDescriptionStyle}" />
      <TextBlock
          x:Name="ValueText"
          Grid.Column="2"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis"
          MaxWidth="280"
          VerticalAlignment="Center" />
      <ContentPresenter
          x:Name="TrailingPresenter"
          Grid.Column="3"
          Grid.RowSpan="3"
          VerticalAlignment="Center" />
      <FontIcon
          x:Name="ChevronIcon"
          Grid.Column="4"
          Grid.RowSpan="3"
          Glyph="&#xE76C;"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          VerticalAlignment="Center"
          AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </Button>
</UserControl>
