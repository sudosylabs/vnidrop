<Window x:Class="VniDrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:VniDrop.Platform" Title="VniDrop">
  <Grid x:Name="Root">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsPaneOpen="True" IsPaneToggleButtonVisible="False"
        OpenPaneLength="220" IsBackButtonVisible="Collapsed" SelectionChanged="Navigate" IsSettingsVisible="True"
        PaneTitle="VniDrop" IsEnabled="{x:Bind Model.Ready, Mode=OneWay}">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavSend" Content="{x:Bind p:Strings.Get('nav_send')}" Tag="send" Icon="Send" />
        <NavigationViewItem x:Name="NavReceive" Content="{x:Bind p:Strings.Get('nav_receive')}" Tag="receive" Icon="Download" />
        <NavigationViewItem x:Name="NavDevices" Content="{x:Bind p:Strings.Get('nav_saved_devices')}" Tag="devices"><NavigationViewItem.Icon><FontIcon Glyph="&#xE772;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="20,0,0,0">
        <Grid Padding="24,22,24,24" RowSpacing="0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <InfoBar x:Name="ErrorBar" IsOpen="{x:Bind Model.HasError, Mode=OneWay}" Message="{x:Bind Model.Error, Mode=OneWay}" Severity="Error" Closed="ErrorClosed" />
          <InfoBar Grid.Row="1" IsOpen="{x:Bind Model.HasRequests, Mode=OneWay}" IsClosable="False" Title="{x:Bind p:Strings.Get('saved_devices_attention_title')}" Severity="Informational">
            <InfoBar.ActionButton><Button Content="{x:Bind p:Strings.Get('windows_review_requests')}" Click="ReviewRequests" /></InfoBar.ActionButton>
          </InfoBar>
          <Frame x:Name="ContentFrame" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Border>
    </NavigationView>
    <Border x:Name="Startup" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="440" Padding="32">
        <TextBlock Text="VniDrop" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <ProgressRing IsActive="{x:Bind Model.Starting, Mode=OneWay}" Visibility="{x:Bind Model.Starting, Mode=OneWay}" Width="32" Height="32" />
        <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" TextWrapping="Wrap" />
        <Button Content="{x:Bind p:Strings.Get('button_retry')}" Click="RetryStartup" HorizontalAlignment="Center" />
        <Button Content="{x:Bind p:Strings.Get('app_identity_reset_action')}" Visibility="{x:Bind Model.CanResetIdentity, Mode=OneWay}" Click="ResetIdentity" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
