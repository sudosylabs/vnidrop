<Page
    x:Class="VniDrop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:VniDrop.Controls"
    xmlns:p="using:VniDrop.Platform">
  <Grid x:Name="Root" Padding="{StaticResource VniDropPagePaddingCompact}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="Root.Padding" Value="{StaticResource VniDropPagePaddingCompact}" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Medium">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="Root.Padding" Value="{StaticResource VniDropPagePaddingMedium}" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
          <VisualState.Setters><Setter Target="Root.Padding" Value="{StaticResource VniDropPagePadding}" /></VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer Style="{StaticResource VniDropPageScrollStyle}">
      <StackPanel x:Name="ContentColumn" MaxWidth="880" HorizontalAlignment="Left" Spacing="24">
        <c:PageHeader
            Title="{x:Bind p:Strings.Get('settings_title')}"
            Subtitle="{x:Bind p:Strings.Get('settings_subtitle')}" />

        <Border Style="{StaticResource VniDropCardStyle}">
          <StackPanel>
            <c:SettingsRow x:Name="PreferencesRow" AutomationProperties.AutomationId="PreferencesRow" Glyph="&#xE77B;" Title="{x:Bind p:Strings.Get('preferences_title')}" ShowChevron="True" Click="OpenPreferences" />
            <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            <c:SettingsRow x:Name="AppearanceRow" AutomationProperties.AutomationId="AppearanceRow" Glyph="&#xE706;" Title="{x:Bind p:Strings.Get('appearance_title')}" ShowChevron="True" Click="OpenAppearance" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource VniDropCardStyle}">
          <StackPanel>
            <c:SettingsRow x:Name="NotificationsRow" AutomationProperties.AutomationId="NotificationsRow" Glyph="&#xEA8F;" Title="{x:Bind p:Strings.Get('notifications_title')}" ShowChevron="True" Click="OpenNotifications" />
            <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            <c:SettingsRow AutomationProperties.AutomationId="StorageRow" Glyph="&#xEDA2;" Title="{x:Bind p:Strings.Get('storage_title')}" ShowChevron="True" Click="OpenStorage" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind p:Strings.Get('settings_advanced_title')}" Style="{StaticResource VniDropSectionTitleStyle}" />
          <Border Style="{StaticResource VniDropCardStyle}">
            <StackPanel>
              <c:SettingsRow x:Name="NetworkRow" AutomationProperties.AutomationId="NetworkRow" Glyph="&#xE968;" Title="{x:Bind p:Strings.Get('settings_network_title')}" ShowChevron="True" Click="OpenNetwork" />
              <Rectangle Height="1" Margin="16,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
              <c:SettingsRow x:Name="AboutRow" AutomationProperties.AutomationId="AboutRow" Glyph="&#xE946;" Title="{x:Bind p:Strings.Get('about_title')}" ShowChevron="True" Click="OpenAbout" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
