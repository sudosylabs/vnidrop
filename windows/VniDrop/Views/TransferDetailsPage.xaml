<Page x:Class="VniDrop.Views.TransferDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:VniDrop.Platform">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Spacing="20" MaxWidth="840" HorizontalAlignment="Left">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Style="{StaticResource IconButton}" Click="Back" AutomationProperties.Name="{x:Bind p:Strings.Get('button_back')}" ToolTipService.ToolTip="{x:Bind p:Strings.Get('button_back')}"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
        <TextBlock Grid.Column="1" Text="{x:Bind p:Strings.Get('send_transfer_details_title')}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        <Button x:Name="ShareButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="Share" AutomationProperties.Name="{x:Bind p:Strings.Get('transfer_share_title')}" ToolTipService.ToolTip="{x:Bind p:Strings.Get('transfer_share_title')}"><FontIcon Glyph="&#xE72D;" FontSize="16" /></Button>
      </Grid>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource VniDropSurfaceCornerRadius}" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Bind Item.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
          <StackPanel Spacing="4"><TextBlock Text="{x:Bind p:Strings.Get('metadata_status')}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Item.Status, Mode=OneWay}" /></StackPanel>
          <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
          <StackPanel Spacing="4"><TextBlock Text="{x:Bind p:Strings.Get('metadata_size')}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Item.Summary, Mode=OneWay}" /></StackPanel>
          <Rectangle x:Name="AccessDivider" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
          <StackPanel x:Name="AccessRow" Spacing="4"><TextBlock Text="{x:Bind p:Strings.Get('send_access_title')}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Item.Access, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Visibility="{x:Bind Item.ShowProgress, Mode=OneWay}" Spacing="6"><ProgressBar Value="{x:Bind Item.Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Item.IsIndeterminate, Mode=OneWay}" /><TextBlock Text="{x:Bind Item.ProgressText, Mode=OneWay}" /></StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="Destinations" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource VniDropSurfaceCornerRadius}">
        <StackPanel>
          <Button x:Name="ActivityButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" Click="Activity">
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{x:Bind p:Strings.Get('transfer_activity_title')}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind p:Strings.Get('transfer_activity_description')}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Visibility="{x:Bind Item.ActivityCountVisibility, Mode=OneWay}" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="9,3"><TextBlock Text="{x:Bind Item.ActivityCount, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" /></Border><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
          </Button>
          <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
          <Button x:Name="ReceiversButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" Click="Receivers">
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{x:Bind p:Strings.Get('transfer_receivers_title')}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind Item.ReceiverSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Visibility="{x:Bind Item.ReceiverCountVisibility, Mode=OneWay}" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="9,3"><TextBlock Text="{x:Bind Item.ReceiverCount, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" /></Border><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
          </Button>
        </StackPanel>
      </Border>
      <StackPanel x:Name="FilesSection" Spacing="10">
        <TextBlock Text="{x:Bind p:Strings.Get('metadata_files')}" Style="{StaticResource SectionTitle}" />
        <ItemsControl x:Name="Files" />
      </StackPanel>
      <Button x:Name="StopButton" HorizontalAlignment="Stretch" Click="Stop"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="16" /><TextBlock x:Name="StopLabel" /></StackPanel></Button>
      <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Click="Delete">
        <Button.Resources>
          <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="VniDropDangerBackgroundPointerOver" />
          <StaticResource x:Key="SubtleButtonBackgroundPressed" ResourceKey="VniDropDangerBackgroundPressed" />
          <StaticResource x:Key="SubtleButtonForegroundPointerOver" ResourceKey="VniDropDangerForeground" />
          <StaticResource x:Key="SubtleButtonForegroundPressed" ResourceKey="VniDropDangerForeground" />
        </Button.Resources>
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="16" /><TextBlock Text="{x:Bind p:Strings.Get('button_delete_transfer')}" /></StackPanel>
      </Button>
    </StackPanel>
  </ScrollViewer>
</Page>
