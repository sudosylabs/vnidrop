FROM rust:1.91-bookworm AS rust
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates pkg-config libgtk-4-dev libadwaita-1-dev \
    dbus-x11 gnome-keyring libsecret-tools xvfb xauth openbox xdotool \
    imagemagick adwaita-icon-theme fonts-cantarell librsvg2-common at-spi2-core python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
WORKDIR /workspace
